# ── Database ──────────────────────────────────────────────────────
# SQLite (local development — default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/partnr_execution_os"

# ── WhatsApp ──────────────────────────────────────────────────────
# Provider: MOCK (default, no credentials needed) or TWILIO
WHATSAPP_PROVIDER="MOCK"

# Required only when WHATSAPP_PROVIDER=TWILIO
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ── AI Task Extraction ────────────────────────────────────────────
# Provider: MOCK (default, works without key) or OPENAI
AI_PROVIDER="MOCK"
# OPENAI_API_KEY="sk-..."

# ── Escalation ────────────────────────────────────────────────────
# Admin contact for Level-2 escalations (7+ days overdue)
ADMIN_NAME="Rohan Mehta"
ADMIN_PHONE="+919876543210"

# ── Job Security ──────────────────────────────────────────────────
# Optional: protect reminder/summary job endpoints from public access
# REMINDER_JOB_SECRET="your-secret-key"

# ── Base URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Email Ingest ──────────────────────────────────────────────────
# Shared secret for the inbound email webhook (Resend → /api/email-ingest).
# Pass as ?secret=... on the webhook URL or as Authorization: Bearer <secret>
# INBOUND_WEBHOOK_SECRET="partnr-ingest-some-random-string"

# ── Observability (Sentry) ────────────────────────────────────────
# All Sentry vars are OPTIONAL. If SENTRY_DSN is unset, error capture is a no-op.
# Get DSN from: https://sentry.io → Project → Settings → Client Keys (DSN)
# SENTRY_DSN="https://...@...ingest.sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="https://...@...ingest.sentry.io/..."   # same DSN, exposed to browser
# SENTRY_ORG="partnr"            # only needed if uploading source maps
# SENTRY_PROJECT="execution-os"  # only needed if uploading source maps
# SENTRY_AUTH_TOKEN="..."        # only needed if uploading source maps in CI

# ── Logging ───────────────────────────────────────────────────────
# Optional override. Defaults: production=info, development=debug
# LOG_LEVEL="info"
